---
interface Props {
	/** Entry slug; matches the `#slug` deep link fragment. Optional: views
	    without deep-link fragments (e.g. SKILLS) omit it. */
	id?: string;
	title: string;
	active?: boolean;
}

const { id, title, active = false } = Astro.props;
---

<li>
	<button
		type="button"
		id={id}
		data-list-item
		data-active={active ? "true" : undefined}
		aria-pressed={active ? "true" : "false"}
		class="view-list-item min-h-11 w-full px-4 font-display text-2xl uppercase leading-[1.05] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-400"
	>
		{title}
	</button>
</li>
