---
import { VISIBLE_SLOTS } from "../../lib/skills/window";

interface Props {
	/** Skill name, e.g. "Go". */
	name: string;
	/** Display category derived from the group key, e.g. "Backend". */
	category: string;
	/** Rank on the 1..4 scale (1 basic, 2 intermediate, 3 advanced, 4 expert). */
	rank: number;
	/** Global list position; the diagonal stagger uses its repeated slot
	    (index % VISIBLE_SLOTS), so the fixed window's geometry never
	    accumulates drift across the 22 cards. */
	index: number;
	active?: boolean;
}

const { name, category, rank, index, active = false } = Astro.props;
---

<!-- No-JS fallback card (skills contract): the page renders all 22 of these
     in normal document flow. The enhanced controller adopts the first seven
     as persistent slot nodes (data-skill-slot), removes the rest, and
     mutates only their content/ARIA afterwards — so this component stays a
     plain static card. It deliberately carries NO data-list-item: the
     generic view.ts list logic must no-op on Skills (its document-level
     Escape still works). -->
<li
	class="skill-list-item"
	style={`--skill-index: ${index % VISIBLE_SLOTS}`}
>
	<button
		type="button"
		data-skill-card
		data-active={active ? "true" : undefined}
		class="skill-card view-list-item flex h-full min-h-11 items-center justify-between gap-4 px-4 py-1.5 font-display text-2xl uppercase leading-[1.05] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-400"
	>
		{/* Counter-skewed content stays upright inside the skewed card; the
		    accessible name composes skill + category + rank from the visible
		    text ("Go Backend RANK 3"). */}
		<span class="skill-card-body">
			<span class="block">{name}</span>
			<span class="skill-card-category">{category}</span>
		</span>
		<span class="skill-card-rank">
			<span class="skill-card-rank-label">RANK</span>
			<span class="skill-card-rank-value">{rank}</span>
		</span>
	</button>
</li>
