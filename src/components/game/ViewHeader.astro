---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<header class="flex flex-col gap-4">
	<h1 class="font-display text-[clamp(2.25rem,6vw,5.5rem)] uppercase leading-[0.95] text-text-on-light">
		{title}
	</h1>
	<div class="flex flex-wrap items-center gap-x-6 gap-y-2">
		<a
			href="/"
			class="view-link font-label text-xl uppercase tracking-[0.08em] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-400"
		>
			Back to menu
		</a>
	</div>
</header>
