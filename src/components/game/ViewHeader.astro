---
import KeyHints from "./KeyHints.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<header class="flex flex-col gap-4">
	<h1 class="font-display text-[clamp(2.25rem,6vw,5.5rem)] uppercase leading-[0.95] text-text-primary">
		{title}
	</h1>
	<div class="flex flex-wrap items-center gap-x-6 gap-y-2">
		<a
			href="/"
			class="font-label text-xl uppercase tracking-[0.08em] text-text-secondary transition-colors duration-150 ease-out hover:text-accent-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-400"
		>
			Back to menu
		</a>
		<KeyHints />
	</div>
</header>
