---
import type { SiteConfig } from "../../lib/content/schemas";

interface Props {
	site: SiteConfig;
}

const { site } = Astro.props;

// Design AD1 per-item diagonal config: inline CSS vars consumed by the single
// .menu-item rule in global.css. Offsets are the exact AD1 desktop values;
// regular items sit at −14° and the largest item (PROJECTS) at −16°. Tablet
// halves offsets and skews via calc; coarse/<768px collapse everything via
// CSS — no JS involved.
const MENU_ITEMS = [
	{
		label: "About",
		href: "/about",
		offset: "-2.25rem",
		skew: "-14deg",
		size: "clamp(2.75rem, 9vw, 8.125rem)",
	},
	{
		label: "Resume",
		href: "/resume",
		offset: "1.5rem",
		skew: "-14deg",
		size: "clamp(2.75rem, 9vw, 8.125rem)",
	},
	{
		label: "Projects",
		href: "/projects",
		offset: "-3rem",
		skew: "-16deg",
		size: "clamp(3.25rem, 10.5vw, 9.5rem)",
	},
	{
		label: "Skills",
		href: "/skills",
		offset: "2.25rem",
		skew: "-14deg",
		size: "clamp(2.75rem, 9vw, 8.125rem)",
	},
] as const;
---

<main class="game-shell flex min-h-svh flex-col items-center justify-center px-6 py-8">
	<h1 class="sr-only">{site.name}</h1>
	{/* Home-shell decorations (home-shell contract): the giant vertical
	     PORTFOLIO watermark bleeds off the left edge (aria-hidden, zero JS).
	     The old outlined identity card is gone — the top-right utility
	     position belongs to the persisted mute control (ControlCluster). */}
	<div class="shell-decor" aria-hidden="true">
		<span class="shell-watermark" aria-hidden="true">PORTFOLIO</span>
	</div>
	<nav
		aria-label="Game menu"
		data-menu
		class="flex flex-col"
	>
		<ol class="menu-list flex flex-col gap-2">
			{
				MENU_ITEMS.map((item) => (
					<li
						class="menu-item"
						style={`--item-x: ${item.offset}; --item-skew: ${item.skew}; --item-size: ${item.size}`}
					>
						<a
							href={item.href}
							data-menu-item
							data-entrance
							class="group inline-flex min-h-11 items-center font-display uppercase leading-[0.95] transition-colors duration-150 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-400"
						>
							{/* The label sits in its own span so the shell active wedge
							    (::before on the anchor, z-index 1) stays UNDER the
							    crisp black text (span at z-index 2) — the word is
							    covered by the translucent panel and stays legible. */}
							<span class="menu-label">{item.label}</span>
						</a>
					</li>
				))
			}
		</ol>
	</nav>
</main>

<script>
	import "../../scripts/shell";
</script>
