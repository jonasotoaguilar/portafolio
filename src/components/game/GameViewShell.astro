---
import ViewHeader from "./ViewHeader.astro";

interface Props {
	title: string;
	/** Extra classes merged onto the view root (e.g. the skills scrollable
	    variant). */
	class?: string;
}

const { title, class: className = "" } = Astro.props;
---

<main
	class={`game-view flex min-h-svh flex-col gap-6 px-6 py-8 ${className}`}
	data-view
>
	<ViewHeader title={title} />
	<slot />
</main>

<script>
	import "../../scripts/view";
</script>
