---
import type { CollectionEntry } from "astro:content";

interface Props {
  experiences: CollectionEntry<"experience">[];
}

const { experiences } = Astro.props;

const toDateStr = (d: Date | undefined): string =>
  d ? d.toISOString() : new Date().toISOString();

const sorted = experiences.sort((a, b) => {
  const aEnd = toDateStr(a.data.endDate);
  const bEnd = toDateStr(b.data.endDate);
  return bEnd.localeCompare(aEnd);
});
---

{
  sorted.length > 0 ? (
    <div class="relative">
      <!-- Timeline line -->
      <div
        class="absolute left-4 top-0 bottom-0 w-px bg-dark-700 hidden sm:block"
        aria-hidden="true"
      >
      </div>

      <div class="space-y-12">
        {sorted.map((exp) => {
          const start = new Date(exp.data.startDate).getFullYear();
          const end = exp.data.endDate
            ? new Date(exp.data.endDate).getFullYear()
            : "Present";

          return (
            <div class="relative pl-12 sm:pl-16 animate-slide-up">
              <!-- Timeline dot -->
              <div
                class="absolute left-[11px] sm:left-[12px] top-2 w-[10px] h-[10px] rounded-full
                       bg-accent-500 ring-4 ring-dark-950 hidden sm:block"
                aria-hidden="true"
              >
              </div>

              <div>
                <span class="text-sm font-mono text-accent-400">
                  {start} &mdash; {end}
                </span>
                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  {exp.data.role}
                </h3>
                <p class="text-text-secondary font-medium">
                  {exp.data.company}
                </p>
                <p class="text-text-muted text-sm mt-2 leading-relaxed max-w-xl">
                  {exp.data.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ) : (
    <p class="text-text-muted italic">Experience details coming soon.</p>
  )
}
