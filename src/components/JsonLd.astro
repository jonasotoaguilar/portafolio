---
import type { SiteConfig } from "../lib/content/schemas";
import { buildPersonJsonLd, serializeJsonLd } from "../lib/seo/person";

interface Props {
	site: SiteConfig;
}

const { site } = Astro.props;
---

<script type="application/ld+json" is:inline set:html={serializeJsonLd(buildPersonJsonLd(site))}></script>
