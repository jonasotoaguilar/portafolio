const categories = [
  {
    name: "Languages",
    items: ["JavaScript", "TypeScript", "Python", "Java", "SQL", "NoSQL"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  {
    name: "Frameworks & Tools",
    items: ["React", "Next.js", "Spring Boot", "Git", "REST APIs"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>`,
  },
  {
    name: "Focus Areas",
    items: ["Backend", "Web Development", "APIs", "Automation"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v6c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 11v6c0 1.66 4.03 3 9 3s9-1.34 9-3v-6"/></svg>`,
  },
  {
    name: "Practices",
    items: [
      "TDD",
      "Spec-Driven Development",
      "GitHub Actions",
      "AI Agents",
      "Clear APIs",
      "Maintainable Systems",
      "Automation",
    ],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>`,
  },
];
---

<section>
  <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary mb-2">
    Skills
  </h2>
  <p class="text-text-secondary mb-12 max-w-xl">
    Tools and practices I reach for daily.
  </p>

  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {categories.map((cat) => (
      <div class="animate-fade-in">
        <h3 class="inline-flex items-center gap-2 text-sm font-mono text-accent-400 tracking-wider mb-4 uppercase">
          <span class="text-accent-400" set:html={cat.icon} />
          {cat.name}
        </h3>
        <ul class="space-y-2">
          {cat.items.map((item) => (
            <li class="group flex items-center gap-2.5 text-text-secondary text-sm py-0.5 transition-all duration-200 hover:text-text-primary">
              <span
                class="text-text-muted group-hover:text-accent-400 transition-all duration-200 group-hover:scale-110"
                set:html={skillIcons[item] ?? ""}
              />
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
