---
import { site as siteData } from "../data/site";
import { canonicalUrl, ogImageUrl, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT } from "../lib/site-helpers";

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = Astro.url.pathname, noindex = false } = Astro.props as Props;

// Astro.site is set only when SITE env is present (astro.config conditional) — never fabricate
const siteOrigin = Astro.site?.toString();
const canonical = canonicalUrl(siteOrigin, path);
const ogImage = ogImageUrl(siteOrigin);

const fullTitle = title.includes("Jonathan Soto") ? title : `${title} — Jonathan Soto`;

// Safe JSON-LD — Person only, no telephone; sameAs includes constructed LinkedIn URL
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jonathan Soto",
  alternateName: siteData.githubHandle,
  jobTitle: "Backend Engineer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Santiago",
    addressCountry: "CL",
  },
  email: `mailto:${siteData.email}`,
  url: siteOrigin ? canonicalUrl(siteOrigin, "/") ?? siteData.github : siteData.github,
  sameAs: [siteData.github, siteData.linkedinUrl],
  knowsAbout: ["Python", "TypeScript", "Java", "Backend Engineering"],
};

---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="author" content="Jonathan Soto" />
<meta name="color-scheme" content="light" />

<!-- Open Graph basics — only when site is known; otherwise minimal -->
<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />}
{ogImage && <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />}
<meta property="og:site_name" content="Jonathan Soto — Backend Engineer" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
