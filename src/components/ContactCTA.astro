---
---

<section
  id="contact"
  class="py-24 px-4 sm:px-6 lg:px-8 border-t border-dark-800"
>
  <div class="max-w-2xl mx-auto animate-fade-in">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary mb-4 text-center">
      Let's work together
    </h2>
    <p class="text-text-secondary text-lg mb-12 leading-relaxed text-center">
      I'm open to freelance, consulting, and full-time opportunities.
      If you're building something interesting, I'd love to hear about it.
    </p>

    <!-- Contact cards -->
    <div class="grid gap-5 sm:grid-cols-3">

      <!-- Email -->
      <a
        href="mailto:jonasotoaguilar@gmail.com"
        class="group relative rounded-2xl border border-dark-800 bg-dark-900 p-6 text-center transition-all duration-300
               hover:border-accent-500/50 hover:shadow-[0_0_32px_var(--color-glow-400)] hover:-translate-y-1"
        aria-label="Send email to jonasotoaguilar@gmail.com"
      >
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-dark-800 border border-dark-700 mb-4 group-hover:bg-accent-500/20 group-hover:border-accent-500/50 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-secondary group-hover:text-accent-400 transition-colors" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </div>
        <p class="text-text-primary font-semibold text-sm mb-1 group-hover:text-accent-400 transition-colors">Email</p>
        <p class="text-text-muted text-xs truncate">jonasotoaguilar@gmail.com</p>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/jonasotoaguilar"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative rounded-2xl border border-dark-800 bg-dark-900 p-6 text-center transition-all duration-300
               hover:border-accent-500/50 hover:shadow-[0_0_32px_var(--color-glow-400)] hover:-translate-y-1"
        aria-label="Visit Jonathan Soto on GitHub"
      >
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-dark-800 border border-dark-700 mb-4 group-hover:bg-dark-700 group-hover:border-accent-500/40 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-secondary group-hover:text-accent-400 transition-colors" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
        </div>
        <p class="text-text-primary font-semibold text-sm mb-1 group-hover:text-accent-400 transition-colors">GitHub</p>
        <p class="text-text-muted text-xs">@jonasotoaguilar</p>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/jonathan-soto-7304823b8/"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative rounded-2xl border border-dark-800 bg-dark-900 p-6 text-center transition-all duration-300
               hover:border-accent-500/50 hover:shadow-[0_0_32px_var(--color-glow-400)] hover:-translate-y-1"
        aria-label="Visit Jonathan Soto on LinkedIn"
      >
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-dark-800 border border-dark-700 mb-4 group-hover:bg-dark-700 group-hover:border-accent-500/40 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-secondary group-hover:text-accent-400 transition-colors" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect width="4" height="12" x="2" y="9"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </div>
        <p class="text-text-primary font-semibold text-sm mb-1 group-hover:text-accent-400 transition-colors">LinkedIn</p>
        <p class="text-text-muted text-xs line-clamp-1">Jonathan Soto</p>
      </a>

    </div>
  </div>
</section>
