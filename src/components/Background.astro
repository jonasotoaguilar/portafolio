---
// Hidden until the script initializes it (design D4); CSS layers render without JS.
---
<canvas
	id="living-background"
	class="living-background"
	aria-hidden="true"
	hidden
	transition:persist
></canvas>
<script>
	import "../scripts/living-background";
</script>
<style>
	.living-background {
		position: fixed;
		inset: 0;
		z-index: -1;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	/* Keep the hidden-until-init contract: the script removes `hidden`. */
	.living-background[hidden] {
		display: none;
	}
</style>
