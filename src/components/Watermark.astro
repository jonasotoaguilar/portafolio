---
interface Props {
	text: string;
}
const { text } = Astro.props;
---

<span
	class="pointer-events-none absolute inset-y-0 right-0 z-0 flex select-none items-center font-display text-[clamp(4rem,18vw,18.75rem)] uppercase leading-[0.9] text-accent-600 opacity-50"
	aria-hidden="true"
>
	{text}
</span>
