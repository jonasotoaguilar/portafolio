---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;

const cardClasses =
  "group relative rounded-2xl border border-dark-800 bg-dark-900 transition-all duration-300 hover:border-accent-500/60 hover:shadow-[0_0_40px_var(--color-glow-400)] hover:-translate-y-1 animate-slide-up overflow-hidden";

const hasImage = data.image && data.image.length > 0;

function panelClass(title: string): string {
  if (title === "ServiceFlow") {
    return "h-48 w-full relative overflow-hidden bg-gradient-to-br from-[#1e1a2e] via-[#241e3a] to-[#1a1828]";
  }
  return "h-48 w-full relative overflow-hidden bg-gradient-to-br from-[#1a2e1e] via-[#222e24] to-[#18281a]";
}

function abstractPanel(title: string): string {
  if (title === "ServiceFlow") {
    return `<div class="${panelClass(title)}">
      <div class="absolute inset-0 opacity-20">
        <div class="absolute top-4 left-4 w-12 h-12 rounded-full border border-accent-400/40"></div>
        <div class="absolute bottom-6 right-6 w-8 h-8 rounded-full border border-accent-400/30"></div>
        <div class="absolute top-10 right-12 w-4 h-4 rounded-full bg-accent-400/20"></div>
        <div class="absolute top-0 left-1/3 w-px h-full bg-accent-400/10"></div>
        <div class="absolute top-0 left-2/3 w-px h-full bg-accent-400/5"></div>
        <div class="absolute top-1/3 left-0 w-full h-px bg-accent-400/8"></div>
        <div class="absolute top-2/3 left-0 w-full h-px bg-accent-400/5"></div>
      </div>
      <div class="absolute inset-0 opacity-30" style="background: radial-gradient(ellipse at 30% 50%, var(--color-accent-400) 0%, transparent 70%)"></div>
    </div>`;
  }
  return `<div class="${panelClass(title)}">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-6 left-6 w-10 h-10 rounded-full border border-accent-400/30"></div>
      <div class="absolute bottom-4 right-8 w-6 h-6 rounded-full border border-accent-400/25"></div>
      <div class="absolute top-1/2 left-1/4 w-3 h-3 rounded-full bg-accent-400/15"></div>
      <div class="absolute top-4 right-1/3 w-2 h-2 rounded-full bg-accent-400/20"></div>
      <svg class="absolute bottom-8 left-8 text-accent-400/20" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
      </svg>
    </div>
    <div class="absolute inset-0 opacity-25" style="background: radial-gradient(ellipse at 70% 30%, var(--color-accent-400) 0%, transparent 60%)"></div>
  </div>`;
}

const categoryColors: Record<string, string> = {
  "Published / Production / PyME": "border-accent-500/40 bg-accent-500/10 text-accent-400",
  Thesis: "border-amber-500/40 bg-amber-500/10 text-amber-400",
  "Thesis / Serious Game": "border-amber-500/40 bg-amber-500/10 text-amber-400",
  "Thesis / API Integration": "border-sky-500/40 bg-sky-500/10 text-sky-400",
  "Open Source / Practice Project": "border-emerald-500/40 bg-emerald-500/10 text-emerald-400",
};

const catColor =
  data.category && categoryColors[data.category]
    ? categoryColors[data.category]
    : "border-dark-600 bg-dark-800 text-text-muted";

function linkButton(href: string, label: string, ariaLabel: string, iconSvg: string): string {
  return `<a
    href="${href}"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-dark-600 text-text-secondary hover:text-accent-400 hover:border-accent-500/40 hover:bg-dark-800 transition-all duration-200 text-xs font-medium"
    aria-label="${ariaLabel}"
  >
    ${iconSvg}
    ${label}
  </a>`;
}
---

<article class={cardClasses}>
  {hasImage ? (
    <div class="w-full h-48 overflow-hidden">
      <img src={data.image} alt={data.imageAlt ?? data.title} class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
    </div>
  ) : (
    <Fragment set:html={abstractPanel(data.title)} />
  )}

  <div class="p-6">
    {data.category && (
      <span
        class={`inline-flex text-[11px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-md border ${catColor} mb-3 transition-colors duration-300 group-hover:border-opacity-60`}
      >
        {data.category}
      </span>
    )}

    <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent-400 transition-colors mb-3">
      {data.title}
    </h3>

    <p class="text-text-secondary text-sm leading-relaxed mb-4 line-clamp-3">
      {data.description}
    </p>

    {data.tags && data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {data.tags.map((tag: string) => (
          <span class="inline-flex text-xs font-mono px-2 py-1 rounded-md bg-dark-800 text-text-muted group-hover:bg-dark-700 transition-colors">
            {tag}
          </span>
        ))}
      </div>
    )}

    {(data.repoUrl || data.liveUrl || data.thesisUrl) && (
      <div class="flex flex-wrap gap-2 mt-auto">
        {data.repoUrl && (
          <Fragment set:html={linkButton(
            data.repoUrl,
            "Repo",
            `View ${data.title} source code on GitHub`,
            `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`
          )} />
        )}
        {data.liveUrl && (
          <Fragment set:html={linkButton(
            data.liveUrl,
            "Live",
            `View ${data.title} live demo`,
            `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`
          )} />
        )}
        {data.thesisUrl && (
          <Fragment set:html={linkButton(
            data.thesisUrl,
            "Thesis publication",
            `View ${data.title} academic publication`,
            `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>`
          )} />
        )}
      </div>
    )}
  </div>
</article>
