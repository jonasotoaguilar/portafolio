---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props as Props;
const kicker = String(index + 1).padStart(2, "0");
---

<article class="clip-panel flex flex-col p-5 sm:p-6" data-entrance style={`transition-delay:${index * 60}ms`}>
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-7 min-w-7 items-center justify-center border border-[var(--color-ink)] bg-[var(--color-ink)] px-2 font-mono text-[0.7rem] font-bold tracking-widest text-white">
        {kicker}
      </span>
      <h3 class="text-[1.05rem] font-black leading-tight tracking-tight">
        {project.name}
      </h3>
    </div>
    <span class="chip shrink-0">{project.status.includes("Shipped") ? "Shipped" : "Portfolio"}</span>
  </div>

  <p class="mt-3 text-[0.95rem] font-medium leading-snug text-[var(--color-ink-soft)]">
    {project.summary}
  </p>
  <p class="mt-2 text-[0.88rem] leading-relaxed text-[var(--color-muted)] line-clamp-4">
    {project.detail}
  </p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {project.stack.map((s) => (
      <span class="chip text-[0.68rem]">{s}</span>
    ))}
  </div>

  <ul class="mt-4 list-disc space-y-1 pl-5 text-[0.84rem] leading-relaxed text-[var(--color-ink-soft)] marker:text-[var(--color-cyan-strong)]">
    {project.highlights.map((h) => (
      <li>{h}</li>
    ))}
  </ul>

  <div class="mt-5 flex flex-wrap gap-2">
    {project.links.map((l) => (
      <a
        href={l.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 border-[1.5px] border-[var(--color-ink)] bg-white px-3 py-2 text-[0.78rem] font-bold tracking-[0.06em] uppercase hover:bg-[var(--color-ink)] hover:text-white transition-colors"
        style="clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));"
      >
        {l.label}
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>

  <p class="mt-3 font-mono text-[0.72rem] tracking-wide text-[var(--color-muted-2)] break-all">
    {project.repo}
  </p>
</article>
