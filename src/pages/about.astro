---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClippedPanel from "../components/ClippedPanel.astro";
import { Image } from "astro:assets";
import profile from "../assets/visuals/jona-profile.png";
import { education } from "../data/experience";
import { site } from "../data/site";
---

<BaseLayout
  title="About — Human Context, Facts Only"
  description="About Jonathan Soto — USACH Computer Engineering (2020–2025), WealthQuest thesis and May 2025 publication, languages and background."
  path="/about"
>
  <section aria-labelledby="about-heading" class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="space-y-4">
      <ClippedPanel clip="lg" ghost>
        <div class="relative overflow-hidden" data-entrance>
          <Image
            src={profile}
            alt="Portrait of Jonathan Soto — original avatar-inspired illustration"
            widths={[420, 640, 840]}
            sizes="(max-width: 1024px) 100vw, 440px"
            loading="eager"
            decoding="async"
            class="h-auto w-full object-cover"
            style="aspect-ratio: 1/1; object-position: center top;"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[rgba(8,16,33,0.18)] via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
            <span class="border border-[var(--color-ink)] bg-white px-2.5 py-1.5 font-mono text-[0.66rem] font-bold uppercase tracking-[0.08em] shadow-[4px_4px_0_0_var(--color-ink)]">Original · Avatar-derived</span>
            <span class="hidden sm:inline-flex border border-[var(--color-ink)] bg-[var(--color-ink)] px-2.5 py-1.5 font-mono text-[0.66rem] font-bold tracking-wide text-white">02 / PORTRAIT</span>
          </div>
        </div>
      </ClippedPanel>

      <ClippedPanel tint>
        <div class="p-5" data-entrance>
          <h2 class="font-mono text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[var(--color-muted)]">At a glance</h2>
          <ul class="mt-3 space-y-2 font-mono text-[0.78rem] leading-relaxed">
            <li class="flex justify-between gap-2 border-b border-dashed border-[var(--color-border)] py-1.5"><span class="text-[var(--color-muted)]">Name</span><span class="font-bold">Jonathan Soto</span></li>
            <li class="flex justify-between gap-2 border-b border-dashed border-[var(--color-border)] py-1.5"><span class="text-[var(--color-muted)]">Handle</span><span class="font-bold">{site.githubHandle}</span></li>
            <li class="flex justify-between gap-2 border-b border-dashed border-[var(--color-border)] py-1.5"><span class="text-[var(--color-muted)]">Location</span><span class="font-bold">{site.location}</span></li>
            <li class="flex justify-between gap-2 border-b border-dashed border-[var(--color-border)] py-1.5"><span class="text-[var(--color-muted)]">Remote</span><span class="font-bold">Open</span></li>
            <li class="flex justify-between gap-2 py-1.5"><span class="text-[var(--color-muted)]">Focus</span><span class="font-bold">Backend</span></li>
          </ul>
        </div>
      </ClippedPanel>
    </div>

    <div class="space-y-4">
      <ClippedPanel clip="lg" tint>
        <div class="p-6 sm:p-8" data-entrance>
          <p class="font-mono text-[0.72rem] font-bold tracking-[0.16em] uppercase text-[var(--color-cyan-strong)]">Menu 04 · About</p>
          <h1 id="about-heading" class="mt-2 text-[2rem] sm:text-[2.6rem] font-black leading-none tracking-tighter uppercase italic" style="transform: skewX(-6deg);">
            Human <span class="text-[var(--color-cyan-strong)]">Context</span>
          </h1>
          <p class="mt-4 text-[0.98rem] leading-relaxed text-[var(--color-ink-soft)]">
            Backend Engineer from Santiago. I like systems with clear boundaries — bounded contexts, event envelopes, tenant rules — and interfaces that stay honest about shipped state.
          </p>
          <p class="mt-3 text-[0.9rem] leading-relaxed text-[var(--color-muted)]">
            Outside code: learning in public, keeping docs close to code, and choosing tools that hold at 2 a.m.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href="/projects" class="inline-flex items-center gap-2 border-[1.5px] border-[var(--color-ink)] bg-[var(--color-ink)] px-4 py-2 text-[0.78rem] font-bold uppercase tracking-wide text-white hover:bg-white hover:text-[var(--color-ink)] transition-colors">Projects <span aria-hidden="true">→</span></a>
            <a href="/contact" class="inline-flex items-center gap-2 border-[1.5px] border-[var(--color-ink)] bg-white px-4 py-2 text-[0.78rem] font-bold uppercase tracking-wide hover:bg-[var(--color-surface-tint)] transition-colors">Contact</a>
          </div>
        </div>
      </ClippedPanel>

      <ClippedPanel>
        <div class="p-5 sm:p-6" data-entrance>
          <h2 class="font-mono text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[var(--color-muted)]">Education — USACH</h2>
          <h3 class="mt-2 font-black text-[1.05rem] leading-tight">{education.school}</h3>
          <p class="mt-1 font-mono text-[0.78rem] font-bold uppercase tracking-wide text-[var(--color-cyan-strong)]">{education.program}</p>
          <p class="mt-1 font-mono text-[0.74rem] text-[var(--color-muted)]">{education.period}</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div class="border-l-[4px] border-[var(--color-cyan)] bg-[var(--color-cyan-ghost)] px-3 py-3">
              <p class="font-mono text-[0.68rem] font-bold tracking-[0.12em] uppercase text-[var(--color-muted)]">Thesis</p>
              <p class="mt-1 font-bold text-[0.9rem]">{education.thesis.title}</p>
              <p class="mt-1 text-[0.8rem] leading-relaxed text-[var(--color-muted)]">{education.thesis.note}</p>
            </div>
            <div class="border border-[var(--color-border)] bg-[var(--color-surface-tint)] px-3 py-3">
              <p class="font-mono text-[0.68rem] font-bold tracking-[0.12em] uppercase text-[var(--color-muted)]">Languages</p>
              <ul class="mt-2 space-y-1">
                {education.languages.map((l) => (
                  <li class="flex justify-between gap-2 font-mono text-[0.78rem]"><span class="font-bold">{l.name}</span><span class="text-[var(--color-muted)]">{l.level}</span></li>
                ))}
              </ul>
            </div>
          </div>
          <p class="mt-4 font-mono text-[0.72rem] leading-relaxed text-[var(--color-muted)]">
            Co-authors include Soto Aguilar. Published May 2025.
          </p>
        </div>
      </ClippedPanel>

      <ClippedPanel ghost>
        <div class="p-4 sm:p-5 flex flex-wrap items-center justify-between gap-3" data-entrance>
          <p class="font-mono text-[0.74rem] text-[var(--color-muted)]">
            Explore work and experience, or get in touch.
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 border-[1.5px] border-[var(--color-ink)] bg-white px-4 py-2 text-[0.78rem] font-bold uppercase tracking-wide hover:bg-[var(--color-ink)] hover:text-white transition-colors">
            Get in Contact <span aria-hidden="true">→</span>
          </a>
        </div>
      </ClippedPanel>
    </div>
  </section>
</BaseLayout>
