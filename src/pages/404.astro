---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClippedPanel from "../components/ClippedPanel.astro";
---

<BaseLayout
  title="Not Found — 404"
  description="Page not found — explore the six menu scenes: Home, Projects, Skills, Experience, About, Contact."
  path="/404"
  noindex={true}
>
  <section aria-labelledby="notfound-heading" class="mx-auto w-full max-w-[760px] space-y-6">
    <ClippedPanel clip="lg" tint>
      <div class="p-8 sm:p-10 text-center" data-entrance>
        <p class="font-mono text-[0.72rem] font-bold tracking-[0.16em] uppercase text-[var(--color-cyan-strong)]">Menu — 404 · Not Found</p>
        <h1 id="notfound-heading" class="mt-2 text-[3rem] sm:text-[4.5rem] font-black leading-none tracking-tighter uppercase italic" style="transform: skewX(-6deg);">
          404
        </h1>
        <p class="mx-auto mt-3 max-w-[48ch] text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)]">
          This menu has no scene. The portfolio has six — each is a distinct full-screen world over the same water field.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <a href="/" class="inline-flex items-center gap-2 border-[2px] border-[var(--color-ink)] bg-[var(--color-ink)] px-5 py-2.5 text-[0.82rem] font-black tracking-[0.08em] uppercase text-white shadow-[6px_6px_0_0_var(--color-cyan)]">
            Back to Entry <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </ClippedPanel>

    <div class="grid gap-3 sm:grid-cols-3" data-entrance>
      {
        [
          { href: "/projects", label: "Projects", k: "01" },
          { href: "/skills", label: "Skills", k: "02" },
          { href: "/contact", label: "Contact", k: "05" },
        ].map((l) => (
          <a href={l.href} class="clip-panel p-4 hover:bg-[var(--color-surface-tint)] transition-colors flex items-center justify-between gap-2">
            <span class="font-black uppercase tracking-tight">{l.label}</span>
            <span class="font-mono text-[0.72rem] font-bold tracking-wide text-[var(--color-muted)]">{l.k} →</span>
          </a>
        ))
      }
    </div>

    <nav aria-label="All routes" class="flex flex-wrap justify-center gap-2 font-mono text-[0.74rem] font-bold uppercase tracking-wide" data-entrance>
      <a href="/" class="underline decoration-[var(--color-cyan-strong)] decoration-2 underline-offset-4">Home</a>
      <span aria-hidden="true">·</span>
      <a href="/projects" class="underline decoration-[var(--color-cyan-strong)] decoration-2 underline-offset-4">Projects</a>
      <span aria-hidden="true">·</span>
      <a href="/skills" class="underline decoration-[var(--color-cyan-strong)] decoration-2 underline-offset-4">Skills</a>
      <span aria-hidden="true">·</span>
      <a href="/experience" class="underline decoration-[var(--color-cyan-strong)] decoration-2 underline-offset-4">Experience</a>
      <span aria-hidden="true">·</span>
      <a href="/about" class="underline decoration-[var(--color-cyan-strong)] decoration-2 underline-offset-4">About</a>
      <span aria-hidden="true">·</span>
      <a href="/contact" class="underline decoration-[var(--color-cyan-strong)] decoration-2 underline-offset-4">Contact</a>
    </nav>
  </section>
</BaseLayout>
