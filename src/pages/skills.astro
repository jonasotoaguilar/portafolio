---
import { getCollection } from "astro:content";

import GameList from "../components/game/GameList.astro";
import GameViewShell from "../components/game/GameViewShell.astro";
import SkillListItem from "../components/game/SkillListItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { VIEW_TITLES } from "../lib/seo/titles";

const [siteEntry] = await getCollection("siteConfig");
const [skillsEntry] = await getCollection("skills");
if (!siteEntry || !skillsEntry) {
	throw new Error("Expected siteConfig and skills content");
}
const site = siteEntry.data;

// Display category derived from the group key (backend -> Backend).
const categoryLabel = (key: string) =>
	key.charAt(0).toUpperCase() + key.slice(1);

// One flat, ordered card per skill: group order first, entry order within.
// The same records are emitted once in the inline data blob below; the
// enhanced controller reads them from there (no secrets — plain text).
const cards = Object.entries(skillsEntry.data).flatMap(([group, entries]) =>
	entries.map((entry) => ({
		name: entry.name,
		rank: entry.rank,
		category: categoryLabel(group),
	})),
);
---

<BaseLayout title={VIEW_TITLES.skills} site={site}>
		<GameViewShell title="Skills" class="skills-view">
			<div class="skills-white-shield" aria-hidden="true"></div>
			<img
				class="skills-persona"
				src="/assets/persona/persona_skills.png"
				alt=""
				aria-hidden="true"
			/>
		{/* Decorative field watermark (skills contract): giant DEVELOPER word
		    in the display face, rotated along the white parallelogram's
		    diagonal, painted behind the cards (styles in global.css). The
		    outer span is a full-viewport mask clipped with the SAME polygon
		    as the white field (shared --skills-band-polygon), so the inner
		    word can sit closer to the sea-blue boundary without ever
		    painting over it. Outer aria-hidden, zero JS, never interactive. */}
		<span class="skills-watermark" aria-hidden="true">
			<span class="skills-watermark-text">DEVELOPER</span>
		</span>
			<div class="skills-layout">
				{/* Fixed five-slot recycled list (skills contract): the fallback
				    below renders all 22 cards in normal document flow (no-JS). On
				    successful init, skills-scroll.ts adopts the first five as
				    persistent slots (data-skill-slot), removes the rest, and gates
				    the enhanced CSS. In enhanced mode there is no native scrolling:
				    the region is a fixed five-row stage and wheel/keyboard drive the discrete
				    window transitions. */}
				<div class="skills-main-stack">
					<h2 class="skills-list-heading">LIST</h2>
					<div class="skills-scroll-region">
						<div class="skills-rail" data-skills-rail aria-hidden="true">
							<div class="skills-rail-thumb" data-skills-thumb></div>
						</div>
						<div class="skills-viewport" data-skills-viewport>
							<GameList label="Skills">
								{cards.map((card, index) => (
									<SkillListItem
										name={card.name}
										category={card.category}
										rank={card.rank}
										index={index}
										active={index === 0}
									/>
								))}
							</GameList>
						</div>
					</div>
				</div>
			</div>
	</GameViewShell>
</BaseLayout>

{/* The 22 skill records, emitted once for the enhanced controller. The
    JSON is HTML-escaped (safe serialization: no <, >, or & can break out
    of the script element) and contains only public text content. */}
<script
	is:inline
	type="application/json"
	id="skills-data"
	set:html={JSON.stringify(cards)
		.replace(/</g, "\\u003c")
		.replace(/>/g, "\\u003e")
		.replace(/&/g, "\\u0026")}
></script>

<script>
	import "../scripts/skills-scroll";
</script>
