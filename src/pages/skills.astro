---
import { getCollection } from "astro:content";

import GameList from "../components/game/GameList.astro";
import GameViewShell from "../components/game/GameViewShell.astro";
import SkillListItem from "../components/game/SkillListItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { VIEW_TITLES } from "../lib/seo/titles";

const [siteEntry] = await getCollection("siteConfig");
const [skillsEntry] = await getCollection("skills");
if (!siteEntry || !skillsEntry) {
	throw new Error("Expected siteConfig and skills content");
}
const site = siteEntry.data;

// Display category derived from the group key (backend -> Backend).
const categoryLabel = (key: string) =>
	key.charAt(0).toUpperCase() + key.slice(1);

// One flat, ordered card per skill: group order first, entry order within.
// The same records are emitted once in the inline data blob below; the
// enhanced controller reads them from there (no secrets — plain text).
const cards = Object.entries(skillsEntry.data).flatMap(([group, entries]) =>
	entries.map((entry) => ({
		name: entry.name,
		rank: entry.rank,
		category: categoryLabel(group),
	})),
);
---

<BaseLayout title={VIEW_TITLES.skills} site={site}>
	<GameViewShell title="Skills">
		{/* Fixed seven-slot recycled list (skills contract): the fallback
		    below renders all 22 cards in normal document flow (no-JS). On
		    successful init, skills-scroll.ts adopts the first seven as
		    persistent slots (data-skill-slot), removes the rest, and gates
		    the enhanced CSS. In enhanced mode there is no native scrolling:
		    the region is a fixed seven-row stage, the diagonal scrollbar is
		    a fixed visual affordance, and wheel/keyboard drive the discrete
		    window transitions. */}
		<div class="skills-scroll-region">
			<div class="skills-viewport" data-skills-viewport>
				<GameList label="Skills">
					{cards.map((card, index) => (
						<SkillListItem
							name={card.name}
							category={card.category}
							rank={card.rank}
							index={index}
							active={index === 0}
						/>
					))}
				</GameList>
			</div>
			<span
				class="skills-scrollbar"
				data-skills-scrollbar
				aria-hidden="true"
			>
				<span class="skills-scrollbar-thumb" data-skills-thumb></span>
			</span>
		</div>
	</GameViewShell>
</BaseLayout>

{/* The 22 skill records, emitted once for the enhanced controller. The
    JSON is HTML-escaped (safe serialization: no <, >, or & can break out
    of the script element) and contains only public text content. */}
<script
	is:inline
	type="application/json"
	id="skills-data"
	set:html={JSON.stringify(cards)
		.replace(/</g, "\\u003c")
		.replace(/>/g, "\\u003e")
		.replace(/&/g, "\\u0026")}
></script>

<script>
	import "../scripts/skills-scroll";
</script>
