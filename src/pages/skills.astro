---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClippedPanel from "../components/ClippedPanel.astro";
import { skillGroups, positioning } from "../data/skills";
---

<BaseLayout
  title="Skills — Backend Range, No Inflation"
  description="Backend range for Jonathan Soto — languages, frameworks, data, APIs/quality, DevOps, cloud fundamentals — grouped without inflated proficiency."
  path="/skills"
>
  <section aria-labelledby="skills-heading" class="space-y-6">
    <div class="grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
      <ClippedPanel clip="lg" tint>
        <div class="p-6 sm:p-8" data-entrance>
          <p class="font-mono text-[0.72rem] font-bold tracking-[0.16em] uppercase text-[var(--color-cyan-strong)]">Menu 02 · Skills</p>
          <h1 id="skills-heading" class="mt-2 text-[2rem] sm:text-[2.6rem] font-black leading-none tracking-tighter uppercase italic" style="transform: skewX(-6deg);">
            Backend <span class="text-[var(--color-cyan-strong)]">Range</span>
          </h1>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)]">
            {positioning.statement} No seniority inflation, no invented metrics.
          </p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {positioning.primary.map((p) => (
              <span class="chip bg-[var(--color-ink)] text-white border-[var(--color-ink)]">{p} — Primary</span>
            ))}
          </div>
          <p class="mt-4 font-mono text-[0.72rem] leading-relaxed text-[var(--color-muted)]">
            Tip: each card is keyboard-focusable via Tab; no hidden proficiency scores.
          </p>
        </div>
      </ClippedPanel>

      <ClippedPanel>
        <div class="p-5 sm:p-6" data-entrance>
          <h2 class="font-mono text-[0.72rem] font-bold tracking-[0.14em] uppercase text-[var(--color-muted)]">Positioning</h2>
          <div class="mt-3 grid grid-cols-3 gap-2 text-center">
            <div class="border-[1.5px] border-[var(--color-ink)] bg-[var(--color-cyan-ghost)] p-3">
              <p class="font-black text-[1.1rem] leading-none">Python</p>
              <p class="mt-1 font-mono text-[0.68rem] uppercase tracking-wide">Backend · RAG · Events</p>
            </div>
            <div class="border-[1.5px] border-[var(--color-ink)] bg-[var(--color-cyan-ghost)] p-3">
              <p class="font-black text-[1.1rem] leading-none">TypeScript</p>
              <p class="mt-1 font-mono text-[0.68rem] uppercase tracking-wide">Next.js · Plugins</p>
            </div>
            <div class="border-[1.5px] border-[var(--color-ink)] bg-[var(--color-cyan-ghost)] p-3">
              <p class="font-black text-[1.1rem] leading-none">Java</p>
              <p class="mt-1 font-mono text-[0.68rem] uppercase tracking-wide">Spring Boot</p>
            </div>
          </div>
          <div class="mt-4 border-t border-dashed border-[var(--color-border)] pt-4">
            <p class="font-mono text-[0.72rem] font-bold tracking-[0.08em] uppercase text-[var(--color-ink-soft)]">How this reads</p>
            <p class="mt-1 text-[0.84rem] leading-relaxed text-[var(--color-muted)]">
              Languages first, then data + quality + delivery. Nothing here promises staff-level breadth — it maps where evidence exists.
            </p>
          </div>
        </div>
      </ClippedPanel>
    </div>

    {/* Skill matrix — distinct geometry */}
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {skillGroups.map((g, i) => (
        <ClippedPanel>
          <div class="p-5" data-entrance style={`transition-delay:${i * 40}ms`}>
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-black tracking-tight uppercase text-[0.95rem]">{g.label}</h3>
              <span class="inline-flex h-6 w-6 items-center justify-center border border-[var(--color-ink)] bg-[var(--color-ink)] font-mono text-[0.68rem] font-bold text-white">{g.kicker}</span>
            </div>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {g.items.map((item) => (
                <li class="chip text-[0.7rem]">{item}</li>
              ))}
            </ul>
            {g.note && <p class="mt-3 border-l-[3px] border-[var(--color-cyan)] bg-[var(--color-cyan-ghost)] px-2.5 py-2 font-mono text-[0.72rem] leading-relaxed text-[var(--color-muted)]">{g.note}</p>}
          </div>
        </ClippedPanel>
      ))}
    </div>

    <ClippedPanel ghost>
      <div class="flex flex-wrap items-center justify-between gap-3 p-4 sm:p-5" data-entrance>
        <p class="max-w-[56ch] font-mono text-[0.74rem] leading-relaxed text-[var(--color-muted)]">
          No invented proficiency bars. If a skill lacks shipped evidence, it is listed as basic/fundamentals — not hidden behind a percentage.
        </p>
        <a href="/experience" class="inline-flex items-center gap-2 border-[1.5px] border-[var(--color-ink)] bg-white px-4 py-2 text-[0.78rem] font-bold uppercase tracking-wide hover:bg-[var(--color-ink)] hover:text-white transition-colors">
          Verify Experience <span aria-hidden="true">→</span>
        </a>
      </div>
    </ClippedPanel>
  </section>
</BaseLayout>
